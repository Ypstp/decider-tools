            theme: localStorage.getItem('dt_theme') || 'dark',
            lang: localStorage.getItem('dt_lang') || 'en',
            sound: localStorage.getItem('dt_sound') !== 'false',
            shortcut: localStorage.getItem('dt_shortcut') || 'Space',
            history: JSON.parse(localStorage.getItem('dt_history') || '{}')
        };

        // Web Audio API Sound Engine
        let audioCtx = null;
        function playSound(type = 'click') {
            if (!state.sound) return;
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;
                if (type === 'click') {
                    osc.frequency.setValueAtTime(400, now);
                    osc.frequency.exponentialRampToValueAtTime(800, now + 0.05);
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'spin') {
                    osc.frequency.setValueAtTime(300 + Math.random() * 200, now);
                    gain.gain.setValueAtTime(0.05, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'win') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                    osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                }
            } catch(e) {}
        }

        // --- Initialization & UI Binding ---
        document.addEventListener('DOMContentLoaded', () => {
            applyTheme(state.theme);
            applyLang(state.lang);
            buildSidebar();
            buildDashboard();
            initWheel();
            initRoulette();
            initDice();
            initCoin();
            initNumber();
            initChoice();
            initPassword();
            initColor();
            initSettingsModal();
            loadAllHistories();

            // Sidebar toggles
            document.getElementById('sidebarToggleBtn').addEventListener('click', () => {
                const sidebar = document.getElementById('sidebar');
                const main = document.getElementById('mainWrapper');
                if (window.innerWidth <= 768) {
                    sidebar.classList.toggle('mobile-open');
                } else {
                    sidebar.classList.toggle('collapsed');
                    main.classList.toggle('expanded');
                }
                playSound('click');
            });

            document.getElementById('sidebarCloseBtn').addEventListener('click', () => {
                const sidebar = document.getElementById('sidebar');
                const main = document.getElementById('mainWrapper');
                if (window.innerWidth <= 768) {
                    sidebar.classList.remove('mobile-open');
                } else {
                    sidebar.classList.toggle('collapsed');
                    main.classList.toggle('expanded');
                }
                playSound('click');
            });

            document.getElementById('themeToggleBtn').addEventListener('click', () => {
                state.theme = state.theme === 'dark' ? 'light' : 'dark';
                localStorage.setItem('dt_theme', state.theme);
                applyTheme(state.theme);
                playSound('click');
            });

            document.getElementById('soundToggleBtn').addEventListener('click', () => {
                state.sound = !state.sound;
                localStorage.setItem('dt_sound', state.sound);
                playSound('click');
            });

            // Global shortcut listener
            window.addEventListener('keydown', (e) => {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
                const activeView = document.querySelector('.view-panel.active').id;
                if (e.key === ' ' || e.key === 'Enter') {
                    e.preventDefault();
                    triggerActiveAction(activeView);
                }
            });
        });

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
        }

        function applyLang(lang) {
            state.lang = lang;
            document.documentElement.setAttribute('data-lang', lang);
            localStorage.setItem('dt_lang', lang);
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang][key]) {
                    el.textContent = i18n[lang][key];
                }
            });

            buildSidebar();
            buildDashboard();
        }

        function buildSidebar() {
            const container = document.getElementById('navLinksContainer');
            container.innerHTML = `
                <button class="nav-item ${document.getElementById('view-dashboard').classList.contains('active') ? 'active' : ''}" onclick="switchView('dashboard')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    <span data-i18n="dashboard">${i18n[state.lang].dashboard}</span>
                </button>
            `;
            games.forEach(g => {
                const isActive = document.getElementById(`view-${g.id}`).classList.contains('active');
                container.innerHTML += `
                    <button class="nav-item ${isActive ? 'active' : ''}" onclick="switchView('${g.id}')">
                        ${g.icon}
                        <span data-i18n="${g.id}">${i18n[state.lang][g.id]}</span>
                    </button>
                `;
            });
        }

        function buildDashboard() {
            const grid = document.getElementById('dashboardGrid');
            grid.innerHTML = '';
            games.forEach(g => {
                grid.innerHTML += `
                    <div class="game-card" onclick="switchView('${g.id}')">
                        <div class="game-card-icon">${g.icon}</div>
                        <h3>${i18n[state.lang][g.id]}</h3>
                        <p>${i18n[state.lang][g.id + 'Desc'] || ''}</p>
                    </div>
                `;
            });
        }

        function switchView(viewId) {
            document.querySelectorAll('.view-panel').forEach(p => p.classList.remove('active'));
            document.getElementById(`view-${viewId}`).classList.add('active');
            
            const titleKey = viewId === 'dashboard' ? 'dashboard' : viewId;
            document.getElementById('viewTitle').textContent = i18n[state.lang][titleKey] || viewId;

            buildSidebar();
            playSound('click');
        }

        function triggerActiveAction(viewId) {
            if (viewId === 'view-wheel') document.getElementById('spinWheelBtn').click();
            else if (viewId === 'view-roulette') document.getElementById('spinRouletteBtn').click();
            else if (viewId === 'view-dice') document.getElementById('rollDiceBtn').click();
            else if (viewId === 'view-coin') document.getElementById('flipCoinBtn').click();
            else if (viewId === 'view-number') document.getElementById('generateNumberBtn').click();
            else if (viewId === 'view-choice') document.getElementById('pickChoiceBtn').click();
            else if (viewId === 'view-password') document.getElementById('generatePasswordBtn').click();
            else if (viewId === 'view-color') document.getElementById('generateColorBtn').click();
        }

        function recordHistory(gameId, text) {
            if (!state.history[gameId]) state.history[gameId] = [];
            state.history[gameId].unshift({ text, time: new Date().toLocaleTimeString() });
            if (state.history[gameId].length > 20) state.history[gameId].pop();
            localStorage.setItem('dt_history', JSON.stringify(state.history));
            renderHistory(gameId);
        }

        function renderHistory(gameId) {
            const box = document.getElementById(`${gameId}History`);
            if (!box) return;
            box.innerHTML = '';
            (state.history[gameId] || []).forEach(item => {
                box.innerHTML += `<div class="history-item"><span>${item.text}</span><span style="color:var(--text-muted); font-size:0.75rem;">${item.time}</span></div>`;
            });
        }

        function loadAllHistories() {
            games.forEach(g => renderHistory(g.id));
        }

        // --- 1. Wheel of Fortune ---
        let wheelAngle = 0;
        let isWheelSpinning = false;
        function initWheel() {
            const canvas = document.getElementById('wheelCanvas');
            const ctx = canvas.getContext('2d');
            let options = document.getElementById('wheelOptions').value.split('\n').filter(o => o.trim() !== '');

            function drawWheel(angle = 0) {
                const center = canvas.width / 2;
                const radius = center - 10;
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                const arc = (2 * Math.PI) / options.length;
                const colors = ['#0084ff', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899'];

                options.forEach((opt, i) => {
                    const startAngle = angle + i * arc;
                    const endAngle = startAngle + arc;
                    ctx.beginPath();
                    ctx.moveTo(center, center);
                    ctx.arc(center, center, radius, startAngle, endAngle);
                    ctx.closePath();
                    ctx.fillStyle = colors[i % colors.length];
                    ctx.fill();
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 2;
                    ctx.stroke();

                    ctx.save();
                    ctx.translate(center, center);
                    ctx.rotate(startAngle + arc / 2);
                    ctx.textAlign = 'right';
                    ctx.fillStyle = '#ffffff';
                    ctx.font = 'bold 14px "Plus Jakarta Sans"';
                    ctx.fillText(opt.substring(0, 15), radius - 20, 6);
                    ctx.restore();
                });
            }

            drawWheel();

            document.getElementById('updateWheelBtn').addEventListener('click', () => {
                options = document.getElementById('wheelOptions').value.split('\n').filter(o => o.trim() !== '');
                drawWheel(0);
                playSound('click');
            });

            document.getElementById('spinWheelBtn').addEventListener('click', () => {
                if (isWheelSpinning || options.length === 0) return;
                isWheelSpinning = true;
                playSound('spin');

                const spinAngle = Math.random() * Math.PI * 2 + Math.PI * 10;
                const duration = 3000;
                const start = performance.now();

                function animateWheel(now) {
                    const elapsed = now - start;
                    const progress = Math.min(elapsed / duration, 1);
                    const easeOut = 1 - Math.pow(1 - progress, 3);
                    const currentAngle = wheelAngle + spinAngle * easeOut;

                    drawWheel(currentAngle);
                    if (progress < 1) {
                        requestAnimationFrame(animateWheel);
                    } else {
                        wheelAngle = currentAngle % (Math.PI * 2);
                        isWheelSpinning = false;
                        
                        const arc = (2 * Math.PI) / options.length;
                        const normalizedAngle = (2 * Math.PI - (wheelAngle % (Math.PI * 2))) % (Math.PI * 2);
                        const winningIndex = Math.floor(normalizedAngle / arc) % options.length;
                        const winner = options[winningIndex];

                        document.getElementById('wheelWinner').textContent = winner;
                        recordHistory('wheel', winner);
                        playSound('win');
                    }
                }
                requestAnimationFrame(animateWheel);
            });
        }

        // --- 2. Roulette ---
        function initRoulette() {
            const strip = document.getElementById('rouletteStrip');
            let items = document.getElementById('rouletteItems').value.split('\n').filter(i => i.trim() !== '');

            function buildStrip(arr) {
                strip.innerHTML = '';
                // Repeat items to form a long track
                const fullList = [];
                for (let i = 0; i < 5; i++) fullList.push(...arr);
                fullList.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'roulette-card-item';
                    div.textContent = item;
                    strip.appendChild(div);
                });
            }
            buildStrip(items);

            document.getElementById('updateRouletteBtn').addEventListener('click', () => {
                items = document.getElementById('rouletteItems').value.split('\n').filter(i => i.trim() !== '');
                buildStrip(items);
                playSound('click');
            });

            let isRouletteSpinning = false;
            document.getElementById('spinRouletteBtn').addEventListener('click', () => {
                if (isRouletteSpinning || items.length === 0) return;
                isRouletteSpinning = true;
                playSound('spin');

                buildStrip(items);
                const cardWidth = 110;
                const totalCards = items.length * 5;
                const targetIndex = Math.floor(items.length * 2 + Math.random() * items.length);
                const offset = targetIndex * cardWidth - 250 + (cardWidth / 2);

                strip.style.transition = 'transform 3.5s cubic-bezier(0.15, 0.85, 0.25, 1)';
                strip.style.transform = `translateX(-${offset}px)`;

                setTimeout(() => {
                    isRouletteSpinning = false;
                    const winner = items[targetIndex % items.length];
                    document.getElementById('rouletteWinner').textContent = winner;
                    recordHistory('roulette', winner);
                    playSound('win');
                }, 3500);
            });
        }

        // --- 3. Dice Roll ---
        function initDice() {
            const container = document.getElementById('diceStageContainer');
            const countSelect = document.getElementById('diceCountSelect');

            function renderDiceStage(count, values = [1, 6]) {
                container.innerHTML = '';
                for (let i = 0; i < count; i++) {
                    const val = values[i] || 1;
                    container.innerHTML += `
                        <div class="dice-scene">
                            <div class="dice" id="dice-${i}">
                                <div class="dice-face face-1"><div class="dot dot-center"></div></div>
                                <div class="dice-face face-6"><div class="dot d1"></div><div class="dot d2"></div><div class="dot d3"></div><div class="dot d4"></div><div class="dot d5"></div><div class="dot d6"></div></div>
                                <div class="dice-face face-3"><div class="dot d1"></div><div class="dot d2"></div><div class="dot d3"></div></div>
                                <div class="dice-face face-4"><div class="dot d1"></div><div class="dot d2"></div><div class="dot d3"></div><div class="dot d4"></div></div>
                                <div class="dice-face face-2"><div class="dot d1"></div><div class="dot d2"></div></div>
                                <div class="dice-face face-5"><div class="dot d1"></div><div class="dot d2"></div><div class="dot d3"></div><div class="dot d4"></div><div class="dot d5"></div></div>
                            </div>
                        </div>
                    `;
                }
            }
            renderDiceStage(2);

            countSelect.addEventListener('change', () => {
                renderDiceStage(parseInt(countSelect.value));
                playSound('click');
            });

            document.getElementById('rollDiceBtn').addEventListener('click', () => {
                playSound('spin');
                const count = parseInt(countSelect.value);
                const results = [];
                const rotations = {
                    1: { x: 0, y: 0 },
                    2: { x: -90, y: 0 },
                    3: { x: 0, y: -90 },
                    4: { x: 0, y: 90 },
                    5: { x: 90, y: 0 },
                    6: { x: 0, y: 180 }
                };

                for (let i = 0; i < count; i++) {
                    const val = Math.floor(Math.random() * 6) + 1;
                    results.push(val);
                    const diceEl = document.getElementById(`dice-${i}`);
                    if (diceEl) {
                        const rx = rotations[val].x + (Math.random() > 0.5 ? 360 : -360) * 2;
                        const ry = rotations[val].y + (Math.random() > 0.5 ? 360 : -360) * 2;
                        diceEl.style.transition = 'transform 1.2s cubic-bezier(0.15, 0.85, 0.25, 1.15)';
                        diceEl.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
                    }
                }

                setTimeout(() => {
                    const total = results.reduce((a, b) => a + b, 0);
                    document.getElementById('diceWinner').textContent = `${results.join(' + ')} = ${total}`;
                    recordHistory('dice', `${results.join(', ')} (Sum: ${total})`);
                    playSound('win');
                }, 1200);
            });
        }

        // --- 4. Coin Flip ---
        function initCoin() {
            let isFlipping = false;
            let coinRotY = 0;

            document.getElementById('flipCoinBtn').addEventListener('click', () => {
                if (isFlipping) return;
                isFlipping = true;
                playSound('spin');

                const isHeads = Math.random() < 0.5;
                const coin = document.getElementById('coinElement');
                coinRotY += 1800 + (isHeads ? 0 : 180);
                coin.style.transform = `rotateY(${coinRotY}deg)`;

                setTimeout(() => {
                    isFlipping = false;
                    const resultText = isHeads ? (state.lang === 'ru' ? 'ОРЁЛ' : 'HEADS') : (state.lang === 'ru' ? 'РЕШКА' : 'TAILS');
                    document.getElementById('coinWinner').textContent = resultText;
                    recordHistory('coin', resultText);
                    playSound('win');
                }, 1500);
            });
        }

        // --- 5. Random Number ---
        function initNumber() {
            document.getElementById('generateNumberBtn').addEventListener('click', () => {
                playSound('spin');
                const min = parseInt(document.getElementById('numMin').value) || 1;
                const max = parseInt(document.getElementById('numMax').value) || 100;
                const res = Math.floor(Math.random() * (max - min + 1)) + min;
                
                document.getElementById('numberWinner').textContent = res;
                recordHistory('number', res);
                playSound('win');
            });
        }

        // --- 6. Random Choice ---
        function initChoice() {
            document.getElementById('pickChoiceBtn').addEventListener('click', () => {
                playSound('spin');
                const options = document.getElementById('choiceOptions').value.split('\n').filter(o => o.trim() !== '');
                if (options.length === 0) return;
                const res = options[Math.floor(Math.random() * options.length)];
                
                document.getElementById('choiceWinner').textContent = res;
                recordHistory('choice', res);
                playSound('win');
            });
        }

        // --- 7. Password Generator ---
        function initPassword() {
            const range = document.getElementById('pwdLength');
            range.addEventListener('input', () => {
                document.getElementById('pwdLenVal').textContent = range.value;
            });

            document.getElementById('generatePasswordBtn').addEventListener('click', () => {
                playSound('click');
                const len = parseInt(range.value);
                const upper = document.getElementById('pwdUpper').checked;
                const lower = document.getElementById('pwdLower').checked;
                const numbers = document.getElementById('pwdNumbers').checked;
                const symbols = document.getElementById('pwdSymbols').checked;

                let chars = '';
                if (upper) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                if (lower) chars += 'abcdefghijklmnopqrstuvwxyz';
                if (numbers) chars += '0123456789';
                if (symbols) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';

                if (!chars) chars = 'abcdefghijklmnopqrstuvwxyz';

                let pwd = '';
                for (let i = 0; i < len; i++) {
                    pwd += chars.charAt(Math.floor(Math.random() * chars.length));
                }

                document.getElementById('passwordWinner').textContent = pwd;
                recordHistory('password', pwd);
            });

            document.getElementById('copyPasswordBtn').addEventListener('click', () => {
                const pwd = document.getElementById('passwordWinner').textContent;
                if (pwd && pwd !== '-') {
                    navigator.clipboard.writeText(pwd);
                    playSound('click');
                    const btn = document.getElementById('copyPasswordBtn');
                    btn.textContent = 'Copied!';
                    setTimeout(() => btn.textContent = i18n[state.lang].copy || 'Copy', 1500);
                }
            });
        }

        // --- 8. Color Generator ---
        function initColor() {
            document.getElementById('generateColorBtn').addEventListener('click', () => {
                playSound('spin');
                const r = Math.floor(Math.random() * 256);
                const g = Math.floor(Math.random() * 256);
                const b = Math.floor(Math.random() * 256);
                
                const hex = '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase();
                const rgb = `rgb(${r}, ${g}, ${b})`;
                
                // convert to hsl
                let rNorm = r / 255, gNorm = g / 255, bNorm = b / 255;
                let max = Math.max(rNorm, gNorm, bNorm), min = Math.min(rNorm, gNorm, bNorm);
                let h, s, l = (max + min) / 2;
                if (max === min) {
                    h = s = 0;
                } else {
                    let d = max - min;
                    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
                    switch (max) {
                        case rNorm: h = (gNorm - bNorm) / d + (gNorm < bNorm ? 6 : 0); break;
                        case gNorm: h = (bNorm - rNorm) / d + 2; break;
                        case bNorm: h = (rNorm - gNorm) / d + 4; break;
                    }
                    h /= 6;
                }
                const hsl = `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;

                document.getElementById('colorStage').style.backgroundColor = hex;
                document.getElementById('colorWinner').textContent = hex;
                document.getElementById('valHex').textContent = hex;
                document.getElementById('valRgb').textContent = rgb;
                document.getElementById('valHsl').textContent = hsl;

                recordHistory('color', hex);
                playSound('win');
            });
        }

        // --- Settings Modal ---
        function initSettingsModal() {
            const modal = document.getElementById('settingsModal');
            document.getElementById('settingsBtn').addEventListener('click', () => {
                modal.classList.add('open');
                playSound('click');
            });
            document.getElementById('closeSettingsModal').addEventListener('click', () => {
                modal.classList.remove('open');
                playSound('click');
            });
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.remove('open');
            });

            const langSelect = document.getElementById('langSelect');
            langSelect.value = state.lang;
            langSelect.addEventListener('change', () => {
                applyLang(langSelect.value);
                playSound('click');
            });

            const soundCheck = document.getElementById('soundEnabledCheck');
            soundCheck.checked = state.sound;
            soundCheck.addEventListener('change', () => {
                state.sound = soundCheck.checked;
                localStorage.setItem('dt_sound', state.sound);
                playSound('click');
            });

            const shortcutInput = document.getElementById('shortcutInput');
            shortcutInput.value = state.shortcut;
            shortcutInput.addEventListener('keydown', (e) => {
                e.preventDefault();
                state.shortcut = e.key;
                shortcutInput.value = e.key;
                localStorage.setItem('dt_shortcut', e.key);
            });
        }
    </script>
